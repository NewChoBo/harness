{
  "name": "@newchobo/harness-core",
  "version": "0.1.0-alpha.0",
  "private": false,
  "description": "Core Harness catalog resolver and validation engine.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NewChoBo/harness.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-harness-core": "./dist/src/cli.js"
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test dist/test/*.test.js",
    "validate": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "typescript": "5.9.2"
  }
}
