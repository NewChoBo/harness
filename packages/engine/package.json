{
  "name": "@newchobo/harness",
  "version": "0.0.0-development",
  "private": true,
  "description": "Reference deterministic Engine for NewChoBo Harness semantics and contracts.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "harness": "./dist/src/cli.js"
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test dist/test/*.test.js",
    "validate": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "typescript": "5.9.2"
  }
}
