{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://newchobo.dev/agent-harness/preset.schema.json",
  "title": "Workflow Automation Preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "workflow_automation_preset" },
    "id": { "type": "string", "minLength": 1 },
    "extends": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["supervisor", "worker", "reviewer", "researcher"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "protocols": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "checklists": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "common": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "role": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routine_implementation": { "type": "boolean" },
        "routine_source_review": { "type": "boolean" },
        "may_review_own_nontrivial_output": { "type": "boolean" },
        "write_scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "forbidden_write_scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" }
      }
    },
    "source_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 }
      }
    },
    "result_schema": { "type": "string", "minLength": 1 },
    "public_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "forbidden_terms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
