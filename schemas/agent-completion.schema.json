{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://newchobo.dev/agent-harness/agent-completion.schema.json",
  "title": "Agent Completion Envelope",
  "description": "Terminal agent-session envelope that points to the governing result and receipt contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "request_id", "session_id", "terminal_state"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "agent_completion" },
    "request_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "terminal_state": {
      "enum": ["completed", "failed", "cancelled", "blocked", "input_required"]
    },
    "result": { "type": "object" },
    "result_schema": { "type": "string", "minLength": 1 },
    "receipt_ref": { "type": "string", "minLength": 1 },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": { "properties": { "terminal_state": { "const": "completed" } } },
      "then": { "required": ["result", "result_schema"] }
    },
    {
      "if": { "properties": { "terminal_state": { "const": "failed" } } },
      "then": { "required": ["error"] }
    }
  ]
}
