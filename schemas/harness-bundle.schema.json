{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://newchobo.dev/agent-harness/harness-bundle.schema.json",
  "title": "Harness Bundle Manifest",
  "description": "Portable, exact-version distribution manifest for Harness definitions and schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "kind", "name", "version", "resources", "entrypoints"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "kind": { "const": "harness_bundle" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog"],
      "properties": {
        "catalog": { "type": "string", "minLength": 1 }
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
